# Secrets / tokens — never committed, only ever held in process memory
*.env
.env.*
**/*token*.json
**/*.secrets.json

# PAC CLI / Azure auth profiles and caches
**/pac-auth-cache/
.pac/
.azure/

# Logs — may contain request metadata, kept local only
logs/*
!logs/.gitkeep

# Solution export artifacts are tracked selectively; ignore transient zips
# and downloaded solution-checker reports. solution/unpacked/ (the actual
# source-controlled solution) IS tracked.
solution/*.zip
solution/check-results/

# Local editor / OS noise
.vscode/
*.user
Thumbs.db

# Local Claude Code permission overrides - machine-specific, not shared
.claude/settings.local.json

# Real Dataverse environment config (Org URL + Tenant ID) - not a credential
# by itself, but identifies exactly which tenant/environment to target, so
# it stays out of a public repo. Copy scripts/config*.psd1.example to the
# non-.example filename and fill in your own environment's values.
scripts/config.psd1
scripts/config.si-test.psd1

# .NET build output - rebuilt by `dotnet build -c Release`, not tracked.
# The .snk strong-name key IS tracked (see plugins/*/*.snk) - it's not a
# security secret, just an assembly identity token Dataverse's
# pluginassemblies API requires, and committing it keeps redeploys from
# silently changing the assembly's PublicKeyToken.
plugins/**/bin/
plugins/**/obj/
