<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Dataverse's plugin sandbox only loads .NET Framework assemblies (no
      .NET Core/5+ support as of this writing) - net462 is the framework
      version this project's other tooling (Dataverse Web API scripts)
      happens to already require a Developer Pack for, so it's used here
      too rather than picking a different framework version arbitrarily.
    -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Hsv.ServiceIntake.Plugins</AssemblyName>
    <RootNamespace>Hsv.ServiceIntake.Plugins</RootNamespace>
    <!-- Plugins must not carry PDBs/config into the sandbox; keep the output minimal. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Dataverse's pluginassemblies API rejects unsigned assemblies
         ("Public assembly must have public key token") - strong-name
         signing is required, not optional, for plugin registration. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Hsv.ServiceIntake.Plugins.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" />
  </ItemGroup>

</Project>
